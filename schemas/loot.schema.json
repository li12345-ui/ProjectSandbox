{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loot.schema.json",
  "title": "LootTable",
  "type": "object",
  "required": ["id", "entries"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^loot_[a-z0-9_]+$" },
    "roll_count": { "type": "integer", "minimum": 1, "default": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "weight"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
          "weight": { "type": "integer", "minimum": 0 },
          "count_min": { "type": "integer", "minimum": 1, "default": 1 },
          "count_max": { "type": "integer", "minimum": 1, "default": 1 }
        }
      }
    }
  }
}