{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Recipe",
  "type": "object",
  "required": ["id", "output", "ingredients"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^recipe_[a-z0-9_]+$" },
    "output": {
      "type": "object",
      "required": ["item_id", "count"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "count"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "craft_station": { "enum": ["hand", "workbench", "smelter", "assembler", "loom"], "default": "workbench" },
    "unlock_tier": { "type": "integer", "minimum": 0, "default": 0 }
  }
}